# Copier en .env (jamais commité). Aucune des sources actuelles n'exige de clé.
EXPLORA_ENV=dev
EXPLORA_DATABASE_URL=postgresql+psycopg://explora:explora@localhost:5432/explora
EXPLORA_HTTP_USER_AGENT="explora/0.1 (+https://github.com/jtslab/explora)"
EXPLORA_HTTP_TIMEOUT_S=15
EXPLORA_CACHE_TTL_S=86400

EXPLORA_GEO_API_URL=https://geo.api.gouv.fr
EXPLORA_GEOCODAGE_URL=https://data.geopf.fr/geocodage
EXPLORA_GEORISQUES_URL=https://georisques.gouv.fr/api/v1
EXPLORA_VOEUX_FORMATIONS_URL=https://data.education.gouv.fr/api/explore/v2.1
# HTTP seulement : HTTPS renvoie 404 et le port 8080 annoncé ne répond pas.
EXPLORA_RESIDENCES_ETUDIANTES_URL=http://webservices-v2.crous-mobile.fr
EXPLORA_INSEE_MELODI_URL=https://api.insee.fr/melodi

# Variables PostGIS utilisées par docker-compose
POSTGRES_USER=explora
POSTGRES_PASSWORD=explora
POSTGRES_DB=explora

# Atmo Data (indice ATMO par commune) : compte gratuit sur admindata.atmofrance.org,
# validé manuellement. Pas encore utilisé par le code.
EXPLORA_ATMO_USERNAME=
EXPLORA_ATMO_PASSWORD=
